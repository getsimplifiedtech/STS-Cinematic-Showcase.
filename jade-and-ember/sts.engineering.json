{
  "$schema": "engineering/schemas/sts-engineering.schema.json",
  "schema": "sts/engineering-project@1",
  "project": {
    "id": "jade-and-ember",
    "name": "Jade & Ember",
    "summary": "A fictional modern Chinese kitchen: the STS portfolio demonstration, never a real restaurant."
  },
  "offering": null,
  "paths": {
    "engineering": "engineering",
    "repositoryRoot": ".."
  },
  "governance": {
    "approvalsLog": "docs/JADE_AND_EMBER_APPROVALS.md",
    "approvalIdPrefix": "APR-JE",
    "demonstrationIdPrefix": "DEMO-JE",
    "recordIdSuffix": "JE",
    "documents": {
      "mediaRightsPolicy": "docs/JADE_AND_EMBER_MEDIA_RIGHTS_POLICY.md",
      "deviceTestProtocol": "docs/JADE_AND_EMBER_DEVICE_TEST_PROTOCOL.md"
    }
  },
  "ci": {
    "workflow": "jade-and-ember-verify.yml"
  },
  "delivery": {
    "sharedFiles": [
      "styles.css",
      "home.css",
      "story.css",
      "menu.css",
      "visit.css",
      "order.css",
      "site.js",
      "breath.js",
      "story.js",
      "menu.js",
      "visit.js"
    ],
    "assetFolders": [
      "fonts",
      "media"
    ],
    "configDir": "config",
    "pages": {
      "registry": "config/site.json",
      "list": "pages",
      "key": "file"
    },
    "build": {
      "command": [
        "node",
        "build.mjs",
        "--out",
        "{out}"
      ]
    },
    "stylesheet": "styles.css",
    "sourceRoots": [
      "src",
      "build.mjs"
    ]
  },
  "markup": {
    "selectors": {
      "navToggle": ".nav-toggle",
      "siteNav": "#site-nav",
      "pauseControl": ".pause",
      "ambientHero": "[data-ambient-root]",
      "brandLink": "a.brand",
      "footerNav": ".foot-nav",
      "sectionJump": ".jump",
      "skipLinkClass": "skip"
    },
    "heroStates": {
      "video": "is-video",
      "poster": "push-on"
    },
    "probes": {
      "footerLinkPage": "visit-us.html",
      "sectionJumpPage": "menu.html"
    },
    "heroPreloadPattern": "media\\/hero-wok-v2(-m)?\\.webp"
  },
  "generators": {
    "seo": "src/lib/seo.mjs",
    "crawlers": "src/lib/crawlers.mjs",
    "config": "src/lib/config.mjs"
  },
  "industry": "restaurant",
  "fixtures": {
    "clientBuild": "engineering/project-owned/client-build.mjs",
    "headTag": "engineering/project-owned/head-tag.mjs"
  },
  "baseline": {
    "label": "v0.8",
    "record": "baseline.json",
    "regression": "engineering/project-owned/regression.mjs"
  },
  "creativeAuthority": {
    "record": "authority.json"
  },
  "engine": {
    "projectFolders": [
      "src/lib",
      "tests",
      "tools"
    ],
    "projectFiles": [
      "sts.engineering.json",
      "build.mjs",
      "serve.py",
      "package.json"
    ]
  },
  "checks": {
    "project": [
      {
        "id": "check:framework-matrix",
        "module": "engineering/checks/framework-matrix.mjs",
        "export": "checkFrameworkMatrix",
        "tier": "fast",
        "after": "check:release",
        "scope": "static",
        "reason": "extraction matrix completeness over the repository files; no browser",
        "describe": "Phase 8: the framework extraction and migration matrix classifies every file of the repository, every reference resolves, the generated Markdown is current (an assessment; nothing is extracted)"
      },
      {
        "id": "check:d11",
        "module": "engineering/checks/d11.mjs",
        "export": "checkD11",
        "tier": "full",
        "after": "check:order",
        "scope": "engine",
        "describe": "D-11: the engine honours the style-attribute hashes (photographs keep their crop under the headers) and blocks an unlisted inline style",
        "browser": true
      },
      {
        "id": "check:supports",
        "module": "engineering/checks/supports.mjs",
        "export": "checkSupports",
        "tier": "full",
        "after": "check:d11",
        "scope": "engine",
        "describe": "The approved WebKit text-spacing correction (@supports hanging-punctuation) applies exactly where the engine supports it, as recorded, and the rule is in the stylesheet",
        "browser": true
      },
      {
        "id": "check:selftest-release-control",
        "module": "engineering/checks/je-release-control-layout.mjs",
        "export": "checkSelftestReleaseControl",
        "tier": "full",
        "after": "check:release-dryrun",
        "scope": "static",
        "reason": "the frozen local proof of concept of the release-control repository (41 cases, synthetic data, throwaway folders); no browser",
        "describe": "G6-3A: the release-control proof of concept holds (41 cases: intake, hash-chained ledger, role separation, staging, approval, revocation, freezing, per-client isolation)"
      },
      {
        "id": "check:selftest-je-markup",
        "module": "engineering/checks/je-suites.mjs",
        "export": "checkJeSuites",
        "tier": "full",
        "after": "check:selftest-gate4",
        "scope": "chromium-only",
        "reason": "the project's own original self-test suites (they name Jade & Ember's markup, stylesheet, baseline and engine records); they damage copies and run in Chromium",
        "describe": "the original Jade & Ember self-test suites (base, gates 2 to 6, evidence validator) still hold against the framework engine: every case that names this project's own markup and records",
        "browser": true
      }
    ]
  }
}
