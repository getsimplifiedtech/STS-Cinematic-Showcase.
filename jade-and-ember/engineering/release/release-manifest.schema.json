{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jade-and-ember/release-manifest.json",
  "title": "Release manifest",
  "description": "What a build is, where it came from, and whether it may leave: version, source commit, framework reference, configuration, asset integrity, QA status, approvals, evidence, open findings and the release-gate verdict. Generated by engineering/tools/release.mjs; deterministic for a given commit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "version",
    "channel",
    "source",
    "baseline",
    "framework",
    "configuration",
    "assets",
    "search",
    "security",
    "qa",
    "approvals",
    "evidence",
    "findings",
    "dependencies",
    "gate",
    "package"
  ],
  "properties": {
    "schema": {
      "const": "jade-and-ember/release-manifest@1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "channel": {
      "enum": [
        "demonstration",
        "client-production"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "branch",
        "tree",
        "dirty",
        "commitDate"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": {
          "type": "string"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "commitDate": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "commit",
        "projectTree"
      ],
      "properties": {
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "projectTree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "commit",
        "release",
        "skillSha256",
        "licenseSha256",
        "modifiedByThisProject"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "release": {
          "type": [
            "string",
            "null"
          ]
        },
        "skillSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "licenseSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "modifiedByThisProject": {
          "const": false
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "treeSha256",
        "flags",
        "orderingLive",
        "baseUrl"
      ],
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "treeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "demo",
            "heroVideo",
            "noindex",
            "structuredData"
          ],
          "properties": {
            "demo": {
              "type": "boolean"
            },
            "heroVideo": {
              "type": "boolean"
            },
            "noindex": {
              "type": "boolean"
            },
            "structuredData": {
              "type": "boolean"
            }
          }
        },
        "orderingLive": {
          "type": "boolean"
        },
        "baseUrl": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "treeSha256",
        "fileCount",
        "totalBytes",
        "manifestMatches"
      ],
      "properties": {
        "treeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 1
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 1
        },
        "manifestMatches": {
          "type": "boolean"
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cspSha256",
        "headers",
        "inlineScriptHashes",
        "inlineStyleHashes"
      ],
      "properties": {
        "cspSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inlineScriptHashes": {
          "type": "integer",
          "minimum": 0
        },
        "inlineStyleHashes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified",
        "report"
      ],
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "report": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "passed",
                "commit",
                "checks"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "fast",
                    "full"
                  ]
                },
                "passed": {
                  "type": "boolean"
                },
                "commit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "status"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "status": {
                        "enum": [
                          "pass",
                          "fail"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "present",
        "missing",
        "releaseApproval",
        "rightsVerification",
        "deploymentApproval"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "present": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "date",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "releaseApproval": {
          "type": [
            "string",
            "null"
          ]
        },
        "rightsVerification": {
          "type": [
            "string",
            "null"
          ]
        },
        "deploymentApproval": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "type",
          "commit",
          "valid"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "visual",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "Blocker",
              "Major",
              "Minor",
              "Info"
            ]
          },
          "visual": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lockfileSha256",
        "runtimeDependencies",
        "acceptedAdvisoryPackages"
      ],
      "properties": {
        "lockfileSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtimeDependencies": {
          "type": "integer",
          "minimum": 0
        },
        "acceptedAdvisoryPackages": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "allowed",
        "deploymentApproved",
        "requirements"
      ],
      "properties": {
        "channel": {
          "enum": [
            "demonstration",
            "client-production"
          ]
        },
        "allowed": {
          "type": "boolean"
        },
        "deploymentApproved": {
          "type": "boolean"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "ok",
              "detail"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "ok": {
                "type": "boolean"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "package": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "bytes",
            "sha256"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactsDigest",
        "files",
        "host",
        "urlStyle",
        "crawlers",
        "baseUrlReserved"
      ],
      "properties": {
        "artifactsDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "urlStyle": {
          "enum": [
            "extension",
            "clean"
          ]
        },
        "crawlers": {
          "type": [
            "object",
            "null"
          ]
        },
        "baseUrlReserved": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
