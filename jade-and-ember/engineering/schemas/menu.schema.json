{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jade-and-ember/config/menu.json",
  "title": "Menu",
  "description": "config/menu.json: categories and dishes. Prices are numbers in the menu currency; heat is 0 to 3.",
  "type": "object",
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "price": {
                  "type": "number",
                  "minimum": 0.01
                },
                "heat": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "signature": {
                  "type": "object",
                  "properties": {
                    "image": {
                      "type": "string",
                      "pattern": "^media/[A-Za-z0-9._-]+\\.(webp|webm|mp4)$"
                    },
                    "alt": {
                      "type": "string",
                      "minLength": 11
                    },
                    "focus": {
                      "type": "string",
                      "pattern": "^[0-9]{1,3}% [0-9]{1,3}%$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "order": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3
                    }
                  },
                  "required": [
                    "image",
                    "alt",
                    "focus",
                    "text",
                    "order"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "text",
                "price",
                "heat",
                "tags"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "name",
          "items"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "categories"
  ],
  "additionalProperties": false
}
