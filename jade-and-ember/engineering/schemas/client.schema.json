{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jade-and-ember/config/client.json",
  "title": "Client facts and switches",
  "description": "config/client.json: everything that is true of the restaurant and the build switches. Structure and types only; cross-file rules live in src/lib/config.mjs.",
  "type": "object",
  "properties": {
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "descriptor": {
          "type": "string",
          "minLength": 1
        },
        "seal": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "sealLabel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "descriptor",
        "seal",
        "sealLabel"
      ],
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "properties": {
        "phone": {
          "type": "object",
          "properties": {
            "display": {
              "type": "string",
              "minLength": 1
            },
            "href": {
              "type": "string",
              "pattern": "^tel:\\+?[0-9]+$"
            }
          },
          "required": [
            "display",
            "href"
          ],
          "additionalProperties": false
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        }
      },
      "required": [
        "phone",
        "email"
      ],
      "additionalProperties": false
    },
    "address": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "mapUrl": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://[^\\s]+$"
        }
      },
      "required": [
        "lines",
        "mapUrl"
      ],
      "additionalProperties": false
    },
    "hours": {
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string",
          "pattern": "^[A-Za-z_]+(/[A-Za-z_+-]+)+$"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "days": {
                "type": "string",
                "minLength": 1
              },
              "time": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "days",
              "time"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "timezone",
        "rows"
      ],
      "additionalProperties": false
    },
    "ordering": {
      "type": "object",
      "properties": {
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://[^\\s]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "platformName": {
          "type": "string",
          "minLength": 1
        },
        "headerCta": {
          "enum": [
            "page",
            "direct"
          ]
        },
        "pickupNote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "url",
        "label",
        "platformName",
        "headerCta",
        "pickupNote"
      ],
      "additionalProperties": false
    },
    "seo": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://[^\\s]+$"
        },
        "titleTemplate": {
          "type": "string",
          "pattern": "\\{page\\}"
        },
        "noindex": {
          "type": "boolean"
        },
        "structuredData": {
          "type": "boolean"
        },
        "themeColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "lastModified": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "urlStyle": {
          "enum": [
            "extension",
            "clean"
          ]
        },
        "host": {
          "enum": [
            "cloudflare-pages",
            "vercel",
            "static"
          ]
        },
        "llms": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400,
              "pattern": "^[^\\r\\n]+$"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "crawlers": {
          "type": "object",
          "properties": {
            "search": {
              "enum": [
                "allow",
                "disallow"
              ]
            },
            "aiSearch": {
              "enum": [
                "allow",
                "disallow"
              ]
            },
            "training": {
              "enum": [
                "allow",
                "disallow"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "business": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "Restaurant",
                "FoodEstablishment",
                "CafeOrCoffeeShop",
                "BarOrPub",
                "Bakery",
                "FastFoodRestaurant"
              ]
            },
            "servesCuisine": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "priceRange": {
              "type": "string",
              "pattern": "^(\\${1,4}|[^\\s].{0,29})$"
            },
            "image": {
              "type": "string",
              "pattern": "^media/[A-Za-z0-9._-]+\\.(webp|webm|mp4)$"
            },
            "address": {
              "type": "object",
              "properties": {
                "streetAddress": {
                  "type": "string",
                  "minLength": 1
                },
                "addressLocality": {
                  "type": "string",
                  "minLength": 1
                },
                "addressRegion": {
                  "type": "string",
                  "minLength": 1
                },
                "postalCode": {
                  "type": "string",
                  "minLength": 1
                },
                "addressCountry": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                }
              },
              "required": [
                "streetAddress",
                "addressLocality",
                "postalCode",
                "addressCountry"
              ],
              "additionalProperties": false
            },
            "geo": {
              "type": "object",
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              },
              "required": [
                "latitude",
                "longitude"
              ],
              "additionalProperties": false
            },
            "sameAs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              }
            },
            "hoursSpec": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "dayOfWeek": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "Monday",
                        "Tuesday",
                        "Wednesday",
                        "Thursday",
                        "Friday",
                        "Saturday",
                        "Sunday"
                      ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "opens": {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "closes": {
                    "type": "string",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  }
                },
                "required": [
                  "dayOfWeek",
                  "opens",
                  "closes"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "servesCuisine",
            "priceRange",
            "image",
            "address"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "baseUrl",
        "titleTemplate",
        "noindex",
        "structuredData",
        "themeColor"
      ],
      "additionalProperties": false
    },
    "flags": {
      "type": "object",
      "properties": {
        "demo": {
          "type": "boolean"
        },
        "heroVideo": {
          "type": "boolean"
        }
      },
      "required": [
        "demo",
        "heroVideo"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "brand",
    "contact",
    "address",
    "hours",
    "ordering",
    "seo",
    "flags"
  ],
  "additionalProperties": false
}
