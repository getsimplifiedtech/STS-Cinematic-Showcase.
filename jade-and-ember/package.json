{
  "name": "jade-and-ember",
  "version": "0.1.0",
  "private": true,
  "description": "Jade & Ember — fictional modern Chinese kitchen website concept by STS. Static; no runtime dependencies.",
  "scripts": {
    "build": "node build.mjs",
    "serve": "python3 serve.py",
    "test:a11y": "node tests/qa.mjs",
    "test:lighthouse": "lhci autorun --config=lighthouserc.json",
    "test:contrast": "node tests/contrast.mjs",
    "test:video-tools": "python3 tools/video-qa-selftest.py",
    "test:contrast-sections": "node tests/contrast-sections.mjs",
    "test:site": "node tests/site.mjs",
    "test:variants": "node tests/variants.mjs",
    "test:extracted": "node tests/extracted.mjs",
    "verify": "node engineering/verify.mjs",
    "verify:fast": "node engineering/verify.mjs --fast",
    "check:baseline": "node engineering/checks/baseline.mjs",
    "check:schema": "node engineering/checks/schema.mjs",
    "check:determinism": "node engineering/checks/determinism.mjs",
    "check:authority": "node engineering/checks/authority.mjs",
    "check:regression": "node engineering/checks/regression.mjs",
    "check:selftest": "node engineering/checks/selftest.mjs",
    "check:delivery": "node engineering/checks/delivery.mjs",
    "check:contracts": "node engineering/checks/contracts.mjs",
    "check:media": "node engineering/checks/media.mjs",
    "check:budgets": "node engineering/checks/budgets.mjs",
    "check:keyboard": "node engineering/checks/keyboard.mjs",
    "check:reflow": "node engineering/checks/reflow.mjs",
    "check:forced-colors": "node engineering/checks/forced-colors.mjs",
    "check:a11y-tree": "node engineering/checks/a11y-tree.mjs",
    "check:order": "node engineering/checks/order.mjs",
    "check:selftest-gate2": "node engineering/checks/selftest-gate2.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@lhci/cli": "^0.15.0",
    "ajv": "8.20.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.0",
    "pngjs": "7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
