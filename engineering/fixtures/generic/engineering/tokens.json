{
  "$comment": "Design-token record of the generic fixture (Quillfeather Letterpress). A snapshot of the :root block of styles.css, kept so tokens are checked as engineering structure: defined once, referenced, valid, paired for contrast and unchanged unless the owner approves a visual change. It carries no aesthetic rule and chooses no value: Anthropic Frontend Design decides palette, type and spacing.",
  "authority": "Anthropic Frontend Design (creative); STS (structure and checks only)",
  "frozenFrom": "fixture v0.1.0",
  "tokens": {
    "--paper": "#f6f1e7",
    "--ink": "#1d1b19",
    "--accent": "#8a2f1a",
    "--bar": "#2c2a27",
    "--muted": "#4d4740",
    "--rule": "#8a7f6d",
    "--serif": "Georgia,\"Times New Roman\",serif",
    "--sans": "system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif",
    "--s1": "4px",
    "--s2": "8px",
    "--s3": "12px",
    "--s4": "16px",
    "--s5": "24px",
    "--s6": "32px",
    "--s7": "48px",
    "--gutter": "clamp(16px,4vw,48px)",
    "--target": "44px"
  },
  "unusedAllowed": [
    "--s1",
    "--s7"
  ],
  "localProperties": [],
  "colorLiteralsOutsideRoot": 0,
  "fontFamilies": {},
  "spacingScale": [
    "--s1",
    "--s2",
    "--s3",
    "--s4",
    "--s5",
    "--s6",
    "--s7"
  ],
  "contrastPairs": [
    {
      "fg": "--ink",
      "bg": "--paper",
      "min": 4.5,
      "use": "body text"
    },
    {
      "fg": "--muted",
      "bg": "--paper",
      "min": 4.5,
      "use": "lead text"
    },
    {
      "fg": "--accent",
      "bg": "--paper",
      "min": 4.5,
      "use": "links"
    },
    {
      "fg": "--paper",
      "bg": "--accent",
      "min": 4.5,
      "use": "button label"
    },
    {
      "fg": "--paper",
      "bg": "--bar",
      "min": 4.5,
      "use": "the disclosure bar"
    },
    {
      "fg": "--paper",
      "bg": "--ink",
      "min": 4.5,
      "use": "the footer"
    },
    {
      "fg": "--rule",
      "bg": "--paper",
      "min": 3,
      "use": "rules and borders (graphics)"
    }
  ]
}
