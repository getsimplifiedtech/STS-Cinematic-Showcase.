      "action": ".github/actions/engineering",
      "scripts": "engineering/tools/ci",
      "templates": {
        "caller": "engineering/ci/templates/caller.yml",
        "scheduled": "engineering/ci/templates/scheduled.yml",
        "dependabot": "engineering/ci/templates/dependabot.yml"
      }
    }
  },
  "delivery": {
