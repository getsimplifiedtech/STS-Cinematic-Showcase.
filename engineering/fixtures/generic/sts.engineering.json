  },
  "offering": null,
  "paths": {
    "engineering": "engineering",
    "repositoryRoot": "../../.."
  },
  "governance": {
    "approvalsLog": "engineering/fixtures/generic/APPROVALS.md",
    "approvalIdPrefix": "APR-QF",
    "demonstrationIdPrefix": "DEMO-QF",
    "recordIdSuffix": "QF",
    "documents": {
